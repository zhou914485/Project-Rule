.wheel-screen {
    position: absolute;
    left: 0; right: 0; top: 0; bottom: 0;
    color: #20201d;
    -unity-font-definition: url("project://database/Assets/_Project/UI/Fonts/P4ChineseFont.asset");
}
.wheel-root { position: absolute; width: 650px; height: 650px; }
.rule-fan { position: absolute; left: 0; top: 0; width: 650px; height: 650px; }
.relation-group { position: absolute; left: 0; top: 0; width: 650px; height: 650px; }
.relation-fan { position: absolute; left: 0; top: 0; width: 650px; height: 650px; }
.wheel-word {
    position: absolute;
    width: 88px; height: 36px;
    margin: 0; padding: 0;
    -unity-text-align: middle-center;
    font-size: 20px;
    -unity-font-style: bold;
    white-space: nowrap;
    color: #20201d;
}
.wheel-word.long-word { font-size: 16px; }
.wheel-word.selected { color: #302211; }
.wheel-word.unavailable { color: #4b4943; }
.wheel-word.unavailable.selected { color: #20201d; }
/* 生效中的规则保留暖金色纸牌与深棕色字。 */
.wheel-word.active { color: #5c3b00; }
.wheel-word.active.selected { color: #5c3b00; }
.wheel-feedback {
    position: absolute; left: 350px; top: 610px;
    width: 234px; min-height: 30px;
    margin: 0; padding: 4px 0;
    font-size: 18px;
    -unity-font-style: bold;
    color: #efede1;
}
.hidden { display: none; }
.wheel-root.facing-left .wheel-feedback { left: 66px; }

.wheel-card { position: absolute; background-size: 100% 100%; }
.attribute-card-0 { background-image: url("project://database/Assets/_Project/UI/Art/RuleWheel/Attribute_01_Paper.png"); }
.wheel-glow.attribute-card-0 { background-image: url("project://database/Assets/_Project/UI/Art/RuleWheel/Attribute_01_Mask.png"); }
