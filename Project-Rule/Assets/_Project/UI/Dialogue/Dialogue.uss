.dialogue-screen {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    justify-content: flex-end;
    align-items: center;
    padding-bottom: 6%;
    color: #3a2a14;
    -unity-font-definition: url("DialogueChineseFont.asset");
}

/* 标准通用 UI 组件：Panel_Cream 是 9-slice 面板，四边各保留 22px。 */
.dialogue-paper {
    width: 84%;
    max-width: 920px;
    padding: 30px 38px 26px 38px;
    background-color: transparent;
    background-image: url("project://database/Assets/_Project/UI/Art/Common/Panel_Cream.png");
    -unity-slice-left: 22;
    -unity-slice-right: 22;
    -unity-slice-top: 22;
    -unity-slice-bottom: 22;
    border-width: 0;
    color: #3a2a14;
}

.dialogue-paper Label { margin: 0; padding: 0; }

.dialogue-heading {
    flex-direction: row;
    align-items: center;
    margin-bottom: 10px;
    padding-bottom: 8px;
    border-bottom-width: 1px;
    border-bottom-color: #d9c8a4;
}

.dialogue-speaker {
    font-size: 26px;
    -unity-font-style: bold;
    color: #43301a;
    flex-grow: 1;
}

.dialogue-note { font-size: 13px; color: #8d7a58; }

.dialogue-line {
    font-size: 24px;
    white-space: normal;
    min-height: 72px;
    color: #3a2a14;
}

.dialogue-footer { flex-direction: row; align-items: center; justify-content: flex-end; margin-top: 12px; }

.dialogue-hint {
    display: none;
}

/* 按钮也用同一套 9-slice；颜色只做 tint，不覆盖掉描边。 */
.dialogue-paper Button {
    background-image: url("project://database/Assets/_Project/UI/Art/Common/Button_Cream.png");
    -unity-slice-left: 16;
    -unity-slice-right: 16;
    -unity-slice-top: 12;
    -unity-slice-bottom: 12;
    background-color: transparent;
    min-height: 46px;
    min-width: 130px;
    margin: 0 0 0 12px;
    padding: 8px 22px;
    border-width: 0;
    border-radius: 0;
    color: #43301a;
    font-size: 18px;
    -unity-font-style: bold;
}

.dialogue-paper .dialogue-next {
    -unity-background-image-tint-color: #8b8b42;
    color: #f8f0da;
}

.dialogue-paper .dialogue-close {
    -unity-background-image-tint-color: #a8432c;
    color: #f8f0da;
}

.dialogue-paper Button:hover {
    -unity-background-image-tint-color: #fff1c8;
    color: #43301a;
}

.dialogue-paper .dialogue-next:hover {
    -unity-background-image-tint-color: #9c9c4c;
    color: #f8f0da;
}

.dialogue-paper .dialogue-close:hover {
    -unity-background-image-tint-color: #c2543a;
    color: #f8f0da;
}

.dialogue-paper Button:active {
    -unity-background-image-tint-color: #c6ab79;
    color: #43301a;
}

.dialogue-paper .dialogue-next:active {
    -unity-background-image-tint-color: #6f6f3a;
    color: #f8f0da;
}

.dialogue-paper .dialogue-close:active {
    -unity-background-image-tint-color: #8c3524;
    color: #f8f0da;
}

.dialogue-paper Button:focus {
    border-width: 2px;
    border-color: #614823;
}

.hidden { display: none; }
